# ==============================================================================
# VOICESHIELD — Environment Configuration (.env)
# ==============================================================================

# Core Application Settings
APP_NAME=VoiceShield
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (MongoDB)
# Local instance or MongoDB Atlas URI:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=voiceshield

# Security & Authentication
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=super_secret_voiceshield_jwt_key_32_bytes_min_sih_hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning & Anti-Spoofing Model Settings
AUTO_TRAIN=false
MODEL_TYPE=AASIST
MODEL_CHECKPOINT_PATH=checkpoints/best_model.pth
REPORTS_PATH=reports/model_evaluation.json
DATASETS_PATH=datasets

# Audio Ingestion & Live Stream Parameters
SAMPLE_RATE=16000
TARGET_DURATION_SEC=4.0375
LIVE_CHUNK_SECONDS=2.0
LIVE_HOP_SECONDS=1.0

# Decision & Risk Thresholds
CLASSIFICATION_THRESHOLD=0.50
UNCERTAINTY_MIN=0.45
UNCERTAINTY_MAX=0.55
PURGE_RAW_AUDIO=true
